<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ContactFlow.SequentialFileRenamer</AssemblyName>
    <RootNamespace>ContactFlow.SequentialFileRenamer</RootNamespace>
    <Version>3.6.0</Version>
    <FileVersion>3.6.0.3</FileVersion>
    <AssemblyVersion>3.6.0.0</AssemblyVersion>
    <InformationalVersion>3.6.0-renamer-r3</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
