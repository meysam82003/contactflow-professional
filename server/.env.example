HOST=0.0.0.0
PORT=8787
DATA_DIR=./data
PUBLIC_DIR=..
SESSION_DAYS=30
# For production set a long random secret; never commit it.
CONTACTFLOW_SERVER_SECRET=replace-with-at-least-32-random-bytes
# Same-origin PWA needs no CORS. For Portable/Desktop remote sync, set the allowed frontend origin.
CORS_ORIGIN=https://your-contactflow-domain.example
