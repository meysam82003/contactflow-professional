[Unit]
Description=ContactFlow Professional Gateway
After=network.target

[Service]
Type=simple
User=contactflow
WorkingDirectory=/opt/contactflow/server
EnvironmentFile=/opt/contactflow/server/.env
ExecStart=/usr/bin/node /opt/contactflow/server/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/contactflow/server/data

[Install]
WantedBy=multi-user.target
